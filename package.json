{
  "name": "incenva-scraper-service",
  "version": "1.0.0",
  "description": "Go-based incentive scraper service for Incenva Rebate Finder",
  "private": true,
  "type": "module",
  "scripts": {
    "go:deps": "node scripts/go-mod.mjs download",
    "go:tidy": "node scripts/go-mod.mjs tidy",
    "go:verify": "node scripts/go-mod.mjs verify",
    "run": "node scripts/run.mjs",
    "run:all": "node scripts/run.mjs all",
    "run:dsireusa": "node scripts/run.mjs dsireusa",
    "run:rewiring_america": "node scripts/run.mjs rewiring_america",
    "run:energy_star": "node scripts/run.mjs energy_star",
    "run:con_edison": "node scripts/run.mjs con_edison",
    "run:pnm": "node scripts/run.mjs pnm",
    "run:xcel_energy": "node scripts/run.mjs xcel_energy",
    "run:srp": "node scripts/run.mjs srp",
    "run:peninsula_clean_energy": "node scripts/run.mjs peninsula_clean_energy",
    "pdf": "node scripts/run-pdf.mjs",
    "staging:stats": "node scripts/run-staging-stats.mjs",
    "scraper:promote": "node scripts/run-promoter.mjs",
    "scraper:promote:dry": "node scripts/run-promoter.mjs --dry-run",
    "eval": "node scripts/run-evaluator.mjs",
    "refresh": "node scripts/run.mjs all --force-refresh",
    "refresh:dsireusa": "node scripts/run.mjs dsireusa --force-refresh",
    "refresh:rewiring_america": "node scripts/run.mjs rewiring_america --force-refresh",
    "refresh:energy_star": "node scripts/run.mjs energy_star --force-refresh",
    "refresh:con_edison": "node scripts/run.mjs con_edison --force-refresh",
    "refresh:pnm": "node scripts/run.mjs pnm --force-refresh",
    "refresh:xcel_energy": "node scripts/run.mjs xcel_energy --force-refresh",
    "refresh:srp": "node scripts/run.mjs srp --force-refresh",
    "refresh:peninsula_clean_energy": "node scripts/run.mjs peninsula_clean_energy --force-refresh",
    "run:force": "node scripts/run.mjs all --force-run",
    "run:force:dsireusa": "node scripts/run.mjs dsireusa --force-run",
    "run:force:rewiring_america": "node scripts/run.mjs rewiring_america --force-run",
    "run:force:energy_star": "node scripts/run.mjs energy_star --force-run",
    "run:force:con_edison": "node scripts/run.mjs con_edison --force-run",
    "run:force:pnm": "node scripts/run.mjs pnm --force-run",
    "run:force:xcel_energy": "node scripts/run.mjs xcel_energy --force-run",
    "run:force:srp": "node scripts/run.mjs srp --force-run",
    "run:force:peninsula_clean_energy": "node scripts/run.mjs peninsula_clean_energy --force-run",
    "backfill:zipcode-sources": "psql \"$DATABASE_URL\" -f scripts/backfill-zipcode-sources.sql",
    "migrate": "node scripts/migrations/run-migration.mjs",
    "migrate:001_energy_star_name_fix": "node scripts/migrations/run-migration.mjs 001_energy_star_name_fix",
    "sync:tenants": "node scripts/sync-tenants.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "pg": "^8.21.0"
  }
}